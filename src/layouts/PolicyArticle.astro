---
import BaseLayout from "./BaseLayout.astro";
const { frontmatter } = Astro.props;
---

<BaseLayout title={frontmatter.title} description={frontmatter.description} ogType="article" lang="en">
    <article>
        <header class="page-header">
            <h1 class="page-title">{frontmatter.title}</h1>
            <p class="page-subtitle">{frontmatter.author}</p>
            <time datetime={frontmatter.date}>September 14, 2026</time>
        </header>
        <div class="prose"><slot /></div>
    </article>
</BaseLayout>
