---
import { getEntry, render } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import BackLink from "../components/ui/BackLink.astro";
import Tag from "../components/ui/Tag.astro";
import Icon from "../components/ui/Icon.astro";
import { getDetailItem } from "../utils/adapters";
import { SITE } from "../config";

interface Props {
    collection: "publications" | "teaching";
    id: string;
}

const { collection, id } = Astro.props;
const entry = (await getEntry(collection, id)) as any;

if (!entry) return Astro.redirect("/404");

const { Content } = await render(entry);
const detail = getDetailItem(entry, collection);

function formatMetaHtml(value: string) {
    const escaped = value
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#39;");

    return escaped.replace(
        "The Review of Economics and Statistics",
        "<em>The Review of Economics and Statistics</em>",
    );
}

const meta = [];
if (detail.date) meta.push({ label: "Date", value: detail.date, icon: "Calendar" });
if (detail.authors) meta.push({ label: "Author", value: detail.authors, icon: "User" });
if (detail.extraInput) {
    const icon = "Institution";
    const label = collection === "publications" ? "Journal" : "Institution";
    meta.push({ label, value: detail.extraInput, icon, html: formatMetaHtml(detail.extraInput) });
}

const description = entry.data.description || detail.description || SITE.desc;
const ogImage = entry.data.image || SITE.ogImage;
const siteURL = Astro.site ?? new URL(SITE.website);
const pageURL = new URL(Astro.url.pathname, siteURL).href;
const externalURL = detail.externalUrl
    ? new URL(detail.externalUrl, siteURL).href
    : undefined;

function parseAuthorNames(value?: string) {
    if (!value) return [SITE.author];

    return value
        .replace(/,\s*and\s+/g, ", ")
        .replace(/\s+and\s+/g, ", ")
        .split(",")
        .map((name) => name.trim())
        .filter(Boolean);
}

const structuredData =
    collection === "publications"
        ? {
              "@context": "https://schema.org",
              "@type": "ScholarlyArticle",
              headline: detail.title,
              name: detail.title,
              author: parseAuthorNames(detail.authors).map((name) => ({
                  "@type": "Person",
                  name,
              })),
              abstract: description,
              datePublished: entry.data.date,
              url: pageURL,
              sameAs: externalURL,
              keywords: detail.tags?.join(", "),
              isPartOf:
                  detail.extraInput && detail.extraInput !== "Working paper"
                      ? {
                            "@type": "CreativeWork",
                            name: detail.extraInput,
                        }
                      : undefined,
          }
        : undefined;
---

<BaseLayout
    title={detail.title}
    description={description}
    ogImage={ogImage}
    ogType="article"
    structuredData={structuredData}
>
    <div class="flex justify-between items-center mb-4">
        <BackLink href={detail.backHref} label={collection} />
        {detail.externalUrl && (
            <a href={detail.externalUrl} target="_blank" rel="noopener noreferrer" class="link">
                View external
            </a>
        )}
    </div>

    <article>
        <h1 class="page-title mb-4">{detail.title}</h1>

        {meta.length > 0 && (
            <div class="card-meta mb-4">
                {meta.map((m: any) => (
                    <span class="flex items-center gap-1">
                        <Icon name={m.icon} size={14} />
                        {m.html ? <span set:html={m.html} /> : <span>{m.value}</span>}
                    </span>
                ))}
            </div>
        )}

        {detail.tags && detail.tags.length > 0 && (
            <div class="flex gap-2 flex-wrap mb-4">
                {detail.tags.map((tag: string) => (
                    <Tag name={tag} size="sm" />
                ))}
            </div>
        )}

        <div class="prose">
            <Content />
        </div>

        <slot name="share" />
        <slot name="footer" />
    </article>
</BaseLayout>
