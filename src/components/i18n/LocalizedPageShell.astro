---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
    getLocalizedPage,
    type Locale,
    type LocalizedPageKey,
} from "../../i18n/pages";

interface Props {
    locale: Locale;
    page: LocalizedPageKey;
}

const { locale, page } = Astro.props;
const content = getLocalizedPage(locale, page);
const robots =
    content.status === "published" ? "index, follow" : "noindex, nofollow";
---

<BaseLayout
    title={content.title}
    description={content.description}
    robots={robots}
    lang={locale}
>
    <div class="container-narrow">
        <header class="page-header">
            <h1 class="page-title">{content.title}</h1>
        </header>

        <div class="prose">
            {content.body.map((paragraph) => <p>{paragraph}</p>)}
            {content.facts && content.facts.length > 0 && (
                <ul class="localized-facts">
                    {content.facts.map((fact) => (
                        <li>
                            <strong>{fact.label}</strong>
                            <span class="localized-fact-value">
                                {Array.isArray(fact.value)
                                    ? fact.value.map((line) => <span>{line}</span>)
                                    : fact.value}
                            </span>
                        </li>
                    ))}
                </ul>
            )}
            {content.links && content.links.length > 0 && (
                <ul>
                    {content.links.map((link) => (
                        <li><a href={link.href}>{link.label}</a></li>
                    ))}
                </ul>
            )}
        </div>
    </div>
</BaseLayout>
