---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
    getLocalizedPage,
    type Locale,
    type LocalizedPageKey,
} from "../../i18n/pages";

interface Props {
    locale: Locale;
    page: LocalizedPageKey;
}

const { locale, page } = Astro.props;
const content = getLocalizedPage(locale, page);
const robots =
    content.status === "published" ? "index, follow" : "noindex, nofollow";
---

<BaseLayout
    title={content.title}
    description={content.description}
    robots={robots}
    lang={locale}
>
    <div class="container-narrow">
        <header class="page-header">
            <h1 class="page-title">{content.title}</h1>
        </header>

        <div class="prose">
            {content.body.map((paragraph) => <p>{paragraph}</p>)}
        </div>
    </div>
</BaseLayout>
