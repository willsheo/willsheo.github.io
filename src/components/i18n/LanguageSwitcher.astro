---
import { getLanguageLinks } from "../../i18n/pages";
const links = getLanguageLinks(Astro.url.pathname);
---

<div class="language-options">
    {links.map(({ locale, label, href }) => (
        <a class="language-switcher" href={href} hreflang={locale} lang={locale} dir="auto">{label}</a>
    ))}
</div>

<style>
    .language-options { display: flex; flex-wrap: wrap; gap: 0.5rem; }
</style>
