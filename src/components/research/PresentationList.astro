---
import type { Locale } from "../../i18n/pages";
import { PRESENTATIONS, PRESENTATION_LABELS, type Presentation } from "../../i18n/presentations";

interface Props {
    locale: Locale;
    category: Presentation["category"];
}

const { locale, category } = Astro.props;
const labels = PRESENTATION_LABELS[locale];
const presentations = PRESENTATIONS
    .filter(item => item.approvedForPublication && item.category === category && item.translations[locale])
    .sort((a, b) => b.date.localeCompare(a.date));
---

<section class="section" aria-labelledby={`presentations-${category}`}>
    <h2 id={`presentations-${category}`} class="section-title">{labels[category]}</h2>
    <div class="presentation-content">
    {presentations.length === 0 && <p>{labels.empty}</p>}
    {presentations.map(item => {
        const details = item.translations[locale]!;
        return (
            <article class="research-item" lang={details.language} dir={details.language === "en" ? "ltr" : undefined}>
                <h3 class="research-title" dir="auto">{details.title}</h3>
                <div class="research-meta presentation-meta">
                    <span>{details.location}</span>
                    <time datetime={item.date}>{new Intl.DateTimeFormat(details.language ?? locale, { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" }).format(new Date(item.date))}</time>
                </div>
                {(item.eventUrl || item.slidesUrl) && <div class="research-meta presentation-links">
                    {item.eventUrl && <a href={item.eventUrl}>{labels.source}</a>}
                    {item.slidesUrl && <a href={item.slidesUrl}>{labels.slides}</a>}
                </div>}
            </article>
        );
    })}
    </div>
</section>

<style>
    .presentation-content { margin-inline-start: 1.5rem; }
    .presentation-meta { column-gap: 1em; font-weight: 400; }
    .presentation-links { margin-top: 0.8rem; }
    .presentation-links a { text-decoration: underline; }
</style>
