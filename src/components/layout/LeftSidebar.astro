---
import { SITE, SOCIALS, SOCIAL_ICONS } from "../../config";
import { getCollection } from "astro:content";
import Icon from "../ui/Icon.astro";
import NamePronunciation from "../ui/NamePronunciation.astro";
import { Image } from 'astro:assets';
import {
    getLocaleFromPath,
    LOCALIZED_PROFILE,
} from "../../i18n/pages";

const bioCollection = await getCollection("bio");
const bio = bioCollection[0]?.data;
const locale = getLocaleFromPath(Astro.url.pathname);
const localizedProfile = locale !== "en" ? LOCALIZED_PROFILE[locale] : undefined;
const activeSocials = SOCIALS.filter((s) => s.isActive).map((social) =>
    localizedProfile && social.name === "KIEP Profile"
        ? {
              ...social,
              href: localizedProfile.kiepProfileUrl,
              linkTitle: localizedProfile.kiepProfileLabel,
          }
        : social,
);
const profile = {
    name: localizedProfile?.name ?? bio?.name,
    institution: localizedProfile?.institution ?? bio?.institution,
    title: localizedProfile?.title ?? bio?.shortBio,
    avatarAlt:
        localizedProfile?.avatarAlt ??
        (bio?.name ? `Avatar of ${bio.name}` : "Profile photo"),
};
---

<aside class="sidebar max-lg:flex-row max-lg:flex-wrap max-lg:gap-3 max-md:gap-2">
    <div class="sidebar-profile flex flex-col items-center text-center gap-4 max-lg:flex-row max-lg:text-left max-lg:gap-3 max-lg:items-center max-md:gap-2">
        {bio?.avatar && (
            <Image
                src={`/${bio.avatar}`}
                alt={profile.avatarAlt}
                width={160}
                height={160}
                densities={[1.5, 2]} 
                format="webp"
                class="sidebar-avatar"
                loading="eager"
            />
        )}
        <div
            class={`min-w-0 flex flex-col items-center ${
                locale === "ko" ? "sidebar-profile-ko" : "max-lg:items-start"
            }`}
        >
            {profile.name && (
                <div class="sidebar-name-row flex items-center gap-1">
                    <h1 class="sidebar-name">{profile.name}</h1>
                    {(locale === "ar" || locale === "en") && <NamePronunciation locale={locale} />}
                </div>
            )}
            {profile.institution && (
                <p class="sidebar-info">
                    {profile.institution}
                </p>
            )}
            {profile.title && (
                <p
                    class={
                        locale === "ko"
                            ? "sidebar-info sidebar-title-ko max-md:hidden"
                            : "sidebar-bio mt-2 max-md:hidden"
                    }
                >
                    {profile.title}
                </p>
            )}
            <div class="sidebar-socials flex gap-1 flex-wrap items-center justify-center max-lg:justify-start mt-3">
                {activeSocials.map((social) => (
                    <a
                        href={social.href}
                        aria-label={social.linkTitle}
                        title={social.linkTitle}
                        target="_blank"
                        rel="noreferrer"
                        class="social-link"
                    >
                        <Icon name={SOCIAL_ICONS[social.name] || social.name} size={24} />
                    </a>
                ))}
            </div>
        </div>
    </div>
</aside>
