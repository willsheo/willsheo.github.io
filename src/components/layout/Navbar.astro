---
import { NAV_LINKS, PAGES } from "../../config";
import LanguageSwitcher from "../i18n/LanguageSwitcher.astro";
import {
    getLocaleFromPath,
    getLocalizedPage,
    type LocalizedPageKey,
} from "../../i18n/pages";

const currentPath = Astro.url.pathname;
const currentLocale = getLocaleFromPath(currentPath);

function getPageKey(href: string): LocalizedPageKey {
    return href === "/"
        ? "home"
        : (href.split("/").filter(Boolean)[0] as LocalizedPageKey);
}

function isCurrentPage(href: string, pageKey: LocalizedPageKey): boolean {
    if (pageKey === "home") {
        return currentPath === href || currentPath === href.replace(/\/$/, "");
    }

    const sectionPath = href.endsWith("/") ? href : `${href}/`;
    return currentPath === href || currentPath.startsWith(sectionPath);
}
---

<nav class="navbar">
    <ul class="nav-links">
        {
            NAV_LINKS.filter((link) => {
                const pageKey = getPageKey(link.href);
                const pageConfig = (PAGES as any)[pageKey];
                return link.isActive !== false && pageConfig?.active !== false;
            }).map((link) => {
                const pageKey = getPageKey(link.href);
                const localizedPage = getLocalizedPage(currentLocale, pageKey);
                const href = localizedPage.path;
                const label =
                    currentLocale === "ko" ? localizedPage.title : link.label;

                return (
                    <li>
                        <a
                            href={href}
                            class={`nav-link ${
                                isCurrentPage(href, pageKey)
                                    ? "active"
                                    : "inactive"
                            }`}
                        >
                            {label}
                            <span class="nav-link-line" />
                        </a>
                    </li>
                );
            })
        }
    </ul>
    <LanguageSwitcher />
</nav>
