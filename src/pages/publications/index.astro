---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ResearchList from "../../components/research/ResearchList.astro";
import { PAGES } from "../../config";

if (PAGES.publications.isActive === false) {
    return Astro.redirect("/404");
}

const publications = (await getCollection("publications")).sort((a, b) => {
    const dateA = a.data.date ? new Date(a.data.date).getTime() : 0;
    const dateB = b.data.date ? new Date(b.data.date).getTime() : 0;
    return dateB - dateA;
});

---

<BaseLayout
    title={PAGES.publications.title}
    description={PAGES.publications.description}
>
    <header class="page-header">
        <h1 class="page-title">{PAGES.publications.title}</h1>
        {PAGES.publications.subtitle && <p class="page-subtitle">{PAGES.publications.subtitle}</p>}
    </header>

    <ResearchList publications={publications} />
</BaseLayout>
